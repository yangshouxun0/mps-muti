# OpenAI-compatible API base URL. Do not include /images/generations or /images/edits.
OPENAI_BASE_URL=https://api.openai.com/v1

# Keep the real key only in the user-local .env file. Never commit it.
OPENAI_API_KEY=

# Change this only when the provider uses a different image model identifier.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional output directory. Defaults to the user's Pictures/Codex Generated Images.
# OPENAI_IMAGE_OUTPUT_DIR=
